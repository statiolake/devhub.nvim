#!/bin/sh
# curl, as the adapter's tests see it: the viewer's endpoints from fixtures,
# writes logged with their body.
dir=$(dirname "$0")
url=""
method=GET
body=""
while [ $# -gt 0 ]; do
  case "$1" in
    -X) method=$2; shift ;;
    --data-binary) body=$(cat) ;;
    http*) url=$1 ;;
  esac
  shift
done
case "$url" in
  */ui/files) cat "$dir/files.json" ;;
  */ui/session) echo '{"root":"'"$REVIEW_RELAY_TEST_ROOT"'","diff":true,"diffArgs":["main...HEAD"]}' ;;
  */health) echo '{"ok":true,"version":2,"root":"'"$REVIEW_RELAY_TEST_ROOT"'"}' ;;
  */ui/events) exit 0 ;;
  *) echo "curl $method $url $body" >> "$REVIEW_RELAY_TEST_LOG"; echo '{}' ;;
esac
